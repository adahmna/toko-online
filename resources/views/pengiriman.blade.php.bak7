    margin: 0 0 4px;
}

.pk-langkah p {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin: 0;
}

.pk-refund-note {
    display: flex;
    gap: 16px;
    background: #F3F6FB;
    border: 1px solid #D9E4F3;
    border-radius: 12px;
    padding: 20px 22px;
    margin-top: 28px;
}

.pk-refund-note i {
    color: var(--blue);
    font-size: 18px;
    margin-top: 2px;
}

.pk-refund-note h4 {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 4px;
}

.pk-refund-note p {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin: 0;
}

.pk-faq details {
    border-top: 1px solid var(--line);
    padding: 16px 0;
}

.pk-faq details:last-child {
    border-bottom: 1px solid var(--line);
}

.pk-faq summary {
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.pk-faq summary::-webkit-details-marker {
    display: none;
}

.pk-faq summary::after {
    content: '+';
    font-size: 20px;
    color: var(--ink-soft);
    font-weight: 400;
    flex-shrink: 0;
    margin-left: 16px;
}

.pk-faq details[open] summary::after {
    content: '−';
}

.pk-faq details p {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin: 12px 0 0;
    max-width: 66ch;
}

.pk-cta {
    background: var(--ink);
    padding: 56px 0;
    text-align: center;
}

.pk-cta h2 {
    font-family: 'Fraunces', serif;
    color: #fff;
    font-size: 28px;
    font-weight: 500;
    margin: 0 0 10px;
}

.pk-cta p {
    color: rgba(255,255,255,.7);
    font-size: 14px;
    margin: 0 0 24px;
}

.btn-pk-primary {
    background: var(--coral);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 13px 26px;
    font-weight: 600;
    font-size: 14.5px;
    text-decoration: none;
    display: inline-block;
}

.btn-pk-primary:hover {
    background: #cf4c30;
    color: #fff;
}

@media (max-width: 800px) {
    .pk-hero h1 { font-size: 30px; }
    .pk-ekspedisi-grid { grid-template-columns: repeat(2, 1fr); }
    .pk-flow { flex-direction: column; gap: 20px; }
    .pk-flow-step { padding: 0 0 0 0; }
    .pk-flow-step::after { display: none; }
    .pk-kondisi-grid { grid-template-columns: 1fr; }
}
</style>

<div class="pk-wrapper" style="max-height: 75vh; overflow-y: auto;">
    <div class="pk-container">

