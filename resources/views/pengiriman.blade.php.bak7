<style>
:root {
    --ink: #1E2A3A;
    --ink-soft: #5B6472;
    --blue: #1976D2;
    --coral: #E85D3D;
    --green: #1E8E5A;
    --paper: #FBFAF8;
    --line: #E4E7ED;
}

.pk-wrapper {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.6;
}

.pk-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
}

.pk-serif {
    font-family: 'Fraunces', serif;
}

.pk-hero {
    padding: 72px 0 40px;
    border-bottom: 1px solid var(--line);
}

.pk-hero h1 {
    font-size: 40px;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 18px;
    max-width: 20ch;
}

.pk-hero p {
    font-size: 16px;
    color: var(--ink-soft);
    max-width: 56ch;
    margin: 0 0 32px;
}

.pk-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.pk-fact {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 30px;
    padding: 9px 16px 9px 12px;
    font-size: 13.5px;
    font-weight: 600;
}

.pk-fact i {
    color: var(--coral);
    font-size: 13px;
}

.pk-section {
    padding: 56px 0;
    border-bottom: 1px solid var(--line);
}

.pk-section h2 {
    font-size: 27px;
    font-weight: 500;
    margin: 0 0 8px;
}

.pk-section .pk-lede {
    font-size: 14.5px;
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0 0 32px;
}

.pk-ekspedisi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.pk-ekspedisi-chip {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px 14px;
    background: #fff;
}

.pk-ekspedisi-chip .nm {
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 3px;
}

.pk-ekspedisi-chip .ket {
    font-size: 12px;
    color: var(--ink-soft);
}

.pk-flow {
    display: flex;
    gap: 0;
}

.pk-flow-step {
    flex: 1;
    position: relative;
    padding: 24px 20px 0 0;
}

.pk-flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 11px;
    right: 0;
    width: 100%;
    height: 2px;
    background: var(--line);
}

.pk-flow-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    margin-bottom: 16px;
}

.pk-flow-step h4 {
    font-size: 14.5px;
    font-weight: 700;
    margin: 0 0 6px;
}

.pk-flow-step p {
    font-size: 13px;
    color: var(--ink-soft);
    margin: 0;
    max-width: 24ch;
}

.pk-kondisi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 40px;
}

.pk-kondisi-box {
    border-radius: 12px;
    padding: 22px 24px;
}

.pk-kondisi-box.bisa {
    background: #F0F9F4;
    border: 1px solid #CFE9DA;
}

.pk-kondisi-box.tidak {
    background: #FBF1EE;
    border: 1px solid #F0D9D1;
}

.pk-kondisi-box h4 {
    font-size: 14.5px;
    font-weight: 700;
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.pk-kondisi-box.bisa h4 { color: var(--green); }
.pk-kondisi-box.tidak h4 { color: var(--coral); }

.pk-kondisi-box ul {
    margin: 0;
    padding-left: 18px;
}

.pk-kondisi-box li {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin-bottom: 6px;
}

.pk-langkah {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: langkah;
}

.pk-langkah li {
    counter-increment: langkah;
    display: flex;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
}

.pk-langkah li:first-child {
    border-top: none;
}

.pk-langkah li::before {
    content: counter(langkah);
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    display: flex;
    align-items: center;
