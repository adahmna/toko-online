    }

    .notif-heading {
        padding: 8px 15px;
        font-weight: bold;
        border-bottom: 1px solid #eee;
        cursor: default;
    }

    .notif-item {
        display: block;
        position: relative;
        padding: 10px 15px 10px 28px;
        border-bottom: 1px solid #f2f2f2;
        color: inherit;
        text-decoration: none;
        transition: background 0.15s;
    }

    a.notif-item:hover {
        background: #f7f9fc;
        color: inherit;
        text-decoration: none;
    }

    .notif-item.notif-unread {
        background: #eaf3ff;
    }

    .notif-item.notif-unread:hover {
        background: #dcebff;
    }

    .notif-item .notif-dot {
        display: none;
        position: absolute;
        left: 12px;
        top: 16px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #1976d2;
    }

    .notif-item.notif-unread .notif-dot {
        display: block;
    }

    .notif-item .notif-title {
        font-weight: 600;
        font-size: 13px;
    }

    .notif-item .notif-sub {
        color: #666;
        font-size: 12px;
    }

    .notif-item .notif-time {
        color: #aaa;
        font-size: 11px;
    }

    .notif-empty,
    .notif-error {
        padding: 15px;
        text-align: center;
        color: #999;
    }

    .notif-error {
        color: #c00;
    }

    .header-btns>li.dropdown {
        position: relative;
    }

    .header-btns>li.dropdown .custom-menu {
        display: none;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease;
    }

    .header-btns>li.dropdown:hover .custom-menu {
        display: block !important;
        opacity: 1;
        visibility: visible;
    }

    /* ===== TOAST SELAMAT DATANG (muncul dari atas) ===== */
    .bsi-toast {
        position: fixed !important;
        top: 20px !important;
        left: 50% !important;
        right: auto !important;
        z-index: 10000;
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 12px;
        width: max-content;
        max-width: calc(100vw - 32px);
        box-sizing: border-box;
        padding: 14px 18px;
        background: #fff;
        color: #2b2b2b;
        border-left: 4px solid #F8694A;
        border-radius: 8px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
        transform: translate(-50%, -160%);
        opacity: 0;
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
    }

    .bsi-toast.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    .bsi-toast .bsi-toast-icon {
        flex: 0 0 auto;
        font-size: 26px;
        line-height: 1;
    }

    .bsi-toast .bsi-toast-text {
        flex: 1 1 auto;
        font-size: 14px;
        line-height: 1.5;
    }

    .bsi-toast .bsi-toast-close {
        flex: 0 0 auto;
        background: none;
        border: none;
        color: inherit;
        font-size: 20px;
        line-height: 1;
        opacity: 0.6;
        cursor: pointer;
        padding: 0 2px;
    }

    .bsi-toast .bsi-toast-close:hover {
        opacity: 1;
    }

    [data-theme="dark"] .bsi-toast {
        background: #1e1e1e;
        color: #f1f1f1;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.6);
    }
