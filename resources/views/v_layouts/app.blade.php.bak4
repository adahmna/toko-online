    <!-- ===== IKON HAMBURGER JADI X (nav-icon-final) ===== -->
    <style>
    .nav-toggle-btn i, .menu-header i { display: inline-block; transition: transform .3s ease; }
    .is-x i { transform: rotate(180deg); }
    </style>
    <script>
    (function() {
        var btn = document.querySelector('.nav-toggle-btn');
        var head = document.querySelector('.menu-nav .menu-header');
        var state = false;

        function paint(on) {
            state = on;
            [btn, head].forEach(function(el) {
                if (!el) return;
                var i = el.querySelector('i');
                if (!i) return;
                el.classList.toggle('is-x', on);
                i.classList.toggle('fa-bars', !on);
                i.classList.toggle('fa-times', on);
            });
        }

        paint(false);

        if (btn) btn.addEventListener('click', function() { paint(!state); });
        if (head) head.addEventListener('click', function() { paint(!state); });

        // layar diperlebar: menu mobile hilang, ikon kembali ke hamburger
        window.addEventListener('resize', function() {
            if (window.innerWidth > 991 && state) paint(false);
        });
    })();
    </script>
    <!-- ===== END IKON HAMBURGER JADI X ===== -->

<!-- ===== MENU HEADER: ikon hamburger statis (tanpa animasi) ===== -->
<style>
    .menu-header i {
        transition: none !important;
        transform: none !important;
        animation: none !important;
    }
</style>
<script>
(function () {
    function kunciIkonMenu() {
        document.querySelectorAll('.menu-header i').forEach(function (i) {
            if (!i.classList.contains('fa-bars') || i.classList.contains('fa-times') || i.classList.contains('fa-xmark')) {
                i.classList.remove('fa-times', 'fa-xmark', 'fa-close');
                i.classList.add('fa', 'fa-bars');
            }
            i.style.transform = 'none';
        });
    }
    kunciIkonMenu();
    document.querySelectorAll('.menu-header').forEach(function (h) {
        new MutationObserver(kunciIkonMenu).observe(h, { attributes: true, subtree: true, attributeFilter: ['class', 'style'] });
    });
    document.addEventListener('click', function () { setTimeout(kunciIkonMenu, 0); });
})();
</script>
<!-- ===== END MENU HEADER STATIS ===== -->
</body>

</html>