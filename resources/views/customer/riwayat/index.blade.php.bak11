<div class="modal fade modal-tracking" id="modalTracking" tabindex="-1" role="dialog"
    aria-labelledby="modalTrackingLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content" style="border-radius:12px; overflow:hidden; border:none;">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTrackingLabel">
                    <i class="fas fa-shipping-fast"></i>
                    <span id="mt-kode-pesanan">Lacak Pengiriman</span>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Tutup">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body" style="padding: 20px;">

                <div class="tracking-loading" id="mt-loading">
                    <div class="spinner-border" role="status"></div>
                    <div style="font-size:14px;">Memuat data pengiriman...</div>
                </div>

                <div class="tracking-error" id="mt-error" style="display:none;">
                    <i class="fas fa-exclamation-circle fa-2x mb-2" style="color:#dc3545;"></i>
                    <p style="font-size:13px; margin:0;" id="mt-error-msg">Gagal memuat data tracking.</p>
                </div>

                <div id="mt-content" style="display:none;">

                    <div class="ekspedisi-info-box">
                        <div class="ekspedisi-logo-box" id="mt-logo">JNE</div>
                        <div class="ekspedisi-detail">
                            <div class="ekspedisi-nama" id="mt-ekspedisi-nama">-</div>
                            <div class="ekspedisi-layanan" id="mt-layanan">-</div>
                            <div class="resi-row">
                                <div>
                                    <div class="resi-label-sm">No. Resi Pengiriman</div>
