<script>
// ── Toggle baris detail produk ──
function toggleDetail(rowId) {
    const row = document.getElementById(rowId);
    if (!row) return;
    row.style.display = (row.style.display === 'none' || row.style.display === '') ? 'table-row' : 'none';
}

// ── Data toko (edit sesuai toko kamu) ──
const TOKO = {
    nama: 'BSI Cyber Store',
    alamat: 'Jl. Kramat Raya No.98 RT.02/RW.09, Kramat, Senen, Kota Jakarta Pusat, Daerah Khusus Ibukota Jakarta 10450',
    logo: "{{ asset('image/logo.png') }}"
};

function escHtml(t) {
    return String(t ?? '-').replace(/[&<>"']/g, c => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    } [c]));
}

// ── Cetak invoice dari isi baris detail ──
function cetakInvoice(rowId, btn) {
    const row = document.getElementById(rowId);
    if (!row) return;

    const d = JSON.parse(btn.dataset.invoice || '{}');

    const tableHtml = row.querySelector('.mini-detail-table')?.outerHTML ??
        '<p>Detail produk tidak tersedia.</p>';

    // Hari, tanggal, dan waktu pesanan dibuat, sesuai zona waktu lokasi pemesan (perangkat)
    let hariTanggal = '-';
    let jam = '-';
    if (d.tanggal) {
        const tgl = new Date(d.tanggal);
        const offsetJam = -tgl.getTimezoneOffset() / 60;
        const labelZona = {
            7: 'WIB',
            8: 'WITA',
            9: 'WIT'
        } [offsetJam] || Intl.DateTimeFormat().resolvedOptions().timeZone;

        hariTanggal = tgl.toLocaleDateString('id-ID', {
            weekday: 'long',
            day: '2-digit',
            month: 'long',
            year: 'numeric'
        });
        jam = tgl.toLocaleTimeString('id-ID', {
            hour: '2-digit',
            minute: '2-digit'
        }).replace('.', ':') + ' ' + labelZona;
    }

    const alamatLengkap = escHtml(d.alamat) + (d.kode_pos ? ' (Kode Pos: ' + escHtml(d.kode_pos) + ')' : '');

    const win = window.open('', '_blank');
    win.document.write(`
        <html>
        <head>
            <title>Invoice ${escHtml(d.kode)}</title>
            <style>
                body { font-family: Arial, sans-serif; padding: 30px; color: #1e2a3a; }
                .kop { display: flex; align-items: center; gap: 16px; border-bottom: 3px solid #1976d2; padding-bottom: 14px; margin-bottom: 18px; }
                .kop img { width: 80px; height: 80px; object-fit: contain; }
                .kop h1 { margin: 0 0 4px; font-size: 22px; }
                .kop p { margin: 0; font-size: 13px; color: #555; }
                h2 { margin: 0 0 8px; }
                p { margin: 4px 0; }
                .info { display: flex; gap: 40px; margin-top: 12px; }
                .info > div { flex: 1; }
                .info h4 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase; color: #888; letter-spacing: .05em; }
                table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                th, td { padding: 8px 10px; border-bottom: 1px solid #ddd; text-align: left; }
                th { background: #f5f7fa; }
            </style>
        </head>
        <body>
            <div class="kop">
                <img src="${TOKO.logo}" alt="Logo">
                <div>
                    <h1>${escHtml(TOKO.nama)}</h1>
                    <p>${escHtml(TOKO.alamat)}</p>
                </div>
            </div>

            <h2>Invoice</h2>
            <p>Kode Pesanan: <strong>${escHtml(d.kode)}</strong></p>
            <p>Hari/Tanggal: <strong>${hariTanggal}</strong></p>
            <p>Waktu: <strong>${jam}</strong></p>

            <div class="info">
                <div>
                    <h4>Pemesan</h4>
                    <p><strong>${escHtml(d.pemesan)}</strong></p>
                </div>
                <div>
                    <h4>Penerima</h4>
                    <p><strong>${escHtml(d.penerima)}</strong></p>
                    <p>${alamatLengkap}</p>
                </div>
            </div>

            ${tableHtml}

            <script>
                window.onload = function () { window.focus(); window.print(); };
            <\/script>
        </body>
        </html>
    `);
    win.document.close();
}

// ── Peta ikon & link ekspedisi ──
const EKSPEDISI_MAP = {
    'jne': {
        label: 'JNE',
        nama: 'JNE Express',
        link: 'https://www.jne.co.id/id/tracking/trace/'
    },
    'jnt': {
        label: 'J&T',
        nama: 'J&T Express',
        link: 'https://www.jet.co.id/track'
    },
    'sicepat': {
        label: 'SiCepat',
        nama: 'SiCepat Express',
        link: 'https://sicepat.com/checkAwb'
    },
    'anteraja': {
        label: 'Anteraja',
        nama: 'Anteraja',
        link: 'https://anteraja.id/tracking'
    },
    'pos': {
        label: 'POS ID',
        nama: 'POS Indonesia',
        link: 'https://www.posindonesia.co.id/id/tracking'
    },
    'tiki': {
        label: 'TIKI',
        nama: 'TIKI',
        link: 'https://www.tiki.id/id/tracking'
    },
    'ninja': {
        label: 'Ninja',
        nama: 'Ninja Xpress',
        link: 'https://www.ninjaxpress.co/id-id/tracking'
    },
    'sap': {
        label: 'SAP',
        nama: 'SAP Express',
        link: 'https://sap-express.id/track'
    },
};

let currentResi = '';

function bukaTracking(idPesanan, kodePesanan, ekspedisi, layanan, resi) {
    document.getElementById('mt-loading').style.display = 'block';
    document.getElementById('mt-content').style.display = 'none';
    document.getElementById('mt-error').style.display = 'none';

    document.getElementById('mt-kode-pesanan').textContent = 'Lacak — ' + kodePesanan;

    currentResi = resi;

    $('#modalTracking').modal('show');

    fetch(`/customer/pesanan/${idPesanan}/tracking`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => {
            if (!res.ok) throw new Error('Server error ' + res.status);
            return res.json();
        })
        .then(data => {
            renderTracking(data, ekspedisi, layanan, resi);
        })
        .catch(err => {
            renderTrackingFallback(ekspedisi, layanan, resi);
        });
}

function renderTracking(data, ekspedisi, layanan, resi) {
    if (data.tersedia === false) {
        renderTrackingFallback(ekspedisi, layanan, resi, data.pesan);
        return;
    }
    const eksp = (data.ekspedisi || ekspedisi || '').toLowerCase();
    const lay = data.layanan || layanan || '-';
    const noResi = data.no_resi || resi || '-';
    const eta = data.estimasi_tiba || 'Dalam estimasi 1–2 hari kerja';

    isiTampilanEkspedisi(eksp, lay, noResi, eta);
    document.querySelector('#mt-lokasi-box .lokasi-title').innerHTML =
        '<span class="pulse-dot"></span> Posisi kurir sekarang';

    if (data.posisi_sekarang) {
        document.getElementById('mt-lokasi-nama').textContent = data.posisi_sekarang.nama || '-';
        document.getElementById('mt-lokasi-alamat').textContent = data.posisi_sekarang.alamat || '';
    } else {
        document.getElementById('mt-lokasi-nama').textContent = 'Data posisi belum tersedia';
        document.getElementById('mt-lokasi-alamat').textContent = '';
    }

    document.getElementById('mt-eta').textContent = eta;

    const timeline = data.riwayat || [];
    renderTimeline(timeline);

    tampilkanKonten();
}

function renderTrackingFallback(ekspedisi, layanan, resi, pesan) {
    const eksp = (ekspedisi || '').toLowerCase();

    isiTampilanEkspedisi(eksp, layanan || '-', resi, '-');
    document.querySelector('#mt-lokasi-box .lokasi-title').innerHTML =
        '<span class="pulse-dot" style="background:#adb5bd;animation:none;"></span> Status pelacakan';

    document.getElementById('mt-lokasi-nama').textContent = 'Data pelacakan belum tersedia';
    document.getElementById('mt-lokasi-alamat').textContent = pesan || 'Silakan cek langsung di website ekspedisi.';
    document.getElementById('mt-eta').textContent = '-';

    renderTimeline([]);
    tampilkanKonten();
}
function isiTampilanEkspedisi(eksp, layanan, resi, eta) {
    const info = EKSPEDISI_MAP[eksp] || {
        label: eksp.toUpperCase() || '?',
        nama: eksp || 'Ekspedisi',
        link: '#'
    };

    document.getElementById('mt-logo').textContent = info.label;
    document.getElementById('mt-ekspedisi-nama').textContent = info.nama;
    document.getElementById('mt-layanan').textContent = layanan !== '-' ? 'Layanan: ' + layanan : '';
    document.getElementById('mt-resi').textContent = resi || '-';

    const linkEl = document.getElementById('mt-link-cek');
    linkEl.href = resi ? (info.link + resi) : info.link;
}

function renderTimeline(items) {
    const ul = document.getElementById('mt-timeline');
    ul.innerHTML = '';

    const ikonMap = {
        'current': {
            icon: 'fas fa-truck',
            cls: 'current'
        },
        'done': {
            icon: 'fas fa-check',
            cls: 'done'
        },
        'pending': {
            icon: 'fas fa-circle',
            cls: 'pending'
        },
    };

    items.forEach((item, idx) => {
        const tipe = item.tipe || (idx === 0 ? 'current' : 'done');
        const m = ikonMap[tipe] || ikonMap['done'];

        const li = document.createElement('li');
        li.innerHTML = `
            <div class="tl-icon-wrap">
                <div class="tl-icon ${m.cls}">
                    <i class="${m.icon}" style="font-size:11px;"></i>
                </div>
            </div>
            <div class="tl-content">
                <div class="tl-event ${tipe === 'pending' ? 'pending' : ''}">${escHtml(item.status || '-')}</div>
                ${item.lokasi ? `<div class="tl-lokasi"><i class="fas fa-map-marker-alt" style="font-size:10px;margin-right:3px;"></i>${escHtml(item.lokasi)}</div>` : ''}
                ${item.waktu  ? `<div class="tl-waktu"><i class="far fa-clock" style="font-size:10px;margin-right:3px;"></i>${escHtml(item.waktu)}</div>`  : ''}
            </div>
        `;
        ul.appendChild(li);
    });

    if (items.length === 0) {
        ul.innerHTML =
            '<li><div class="tl-content"><div class="tl-event pending">Belum ada riwayat perjalanan.</div></div></li>';
    }
}

function tampilkanKonten() {
    document.getElementById('mt-loading').style.display = 'none';
    document.getElementById('mt-content').style.display = 'block';
}

function salinResi() {
    if (!currentResi) return;
    navigator.clipboard.writeText(currentResi)
        .then(() => {
            const btn = document.querySelector('.resi-copy-btn');
            btn.innerHTML = '<i class="fas fa-check"></i> Disalin!';
            setTimeout(() => {
                btn.innerHTML = '<i class="far fa-copy"></i> Salin';
            }, 2000);
        })
        .catch(() => alert('Resi: ' + currentResi));
}

// ── Auto-buka tracking/detail kalau datang dari link notifikasi ──
document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const lacakId = params.get('lacak');
    const highlightId = params.get('highlight');

    if (lacakId) {
        const row = document.querySelector(`tr[data-pesanan-id="${lacakId}"]`);
        const btn = row ? row.querySelector('.btn-lacak-sm') : null;
        if (btn) btn.click();
    }

    if (highlightId) {
        const row = document.querySelector(`tr[data-pesanan-id="${highlightId}"]`);
        if (row) {
            row.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
            row.style.background = '#fff8e1';
            const kodeLink = row.querySelector('.kode-pesanan-link');
            if (kodeLink) kodeLink.click();
        }
    }
});
</script>

@endsection