        cursor: not-allowed;
    }
    </style>
</head>

<body>

    <div class="card">
        <div class="card-header">Konfirmasi Pesanan & Pembayaran</div>

        <table class="order-table">
            <thead>
                <tr>
                    <th style="width:40px">No</th>
                    <th>Nama Produk</th>
                    <th>Harga</th>
                    <th style="text-align:center;">Jumlah</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach($pesanan->detailPesanan as $index => $detail)
                <tr>
                    <td>{{ $index + 1 }}</td>
                    <td>{{ $detail->nama_produk }}</td>
                    <td>Rp {{ number_format($detail->harga, 0, ',', '.') }}</td>
                    <td style="text-align:center;">{{ $detail->jumlah }}</td>
                    <td>Rp {{ number_format($detail->subtotal, 0, ',', '.') }}</td>
                </tr>
                @endforeach
                <tr class="total-row">
                    <td colspan="4" style="text-align: right; font-weight: bold;">TOTAL:</td>
                    <td style="font-weight: bold;">Rp {{ number_format($pesanan->total_harga, 0, ',', '.') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="payment-section">
            <div class="payment-title">
                <i class="ti ti-credit-card" style="font-size:15px;vertical-align:-2px;margin-right:6px"
                    aria-hidden="true"></i>
                Klik tombol di bawah untuk memilih metode pembayaran
            </div>

            <button type="button" class="btn-pay" id="pay-button">
                <i class="ti ti-check" aria-hidden="true"></i> Bayar Sekarang
            </button>

            <div class="notice">
                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                Kamu akan diarahkan ke halaman pembayaran resmi Midtrans (Virtual Account, e-wallet, dll).
            </div>
        </div>

        <div class="footer-btns">
            <a href="{{ url('customer/riwayat-belanja') }}" class="btn-back">
                <i class="ti ti-arrow-left" aria-hidden="true"></i> Kembali
            </a>
        </div>
    </div>

    <!-- Snap.js dari Midtrans -->
    <script src="https://app.sandbox.midtrans.com/snap/snap.js" data-client-key="{{ config('midtrans.client_key') }}">
    </script>

    <script>
    const payBtn    = document.getElementById('pay-button');
    const snapToken = @json($snapToken);
    const labelBayar = '<i class="ti ti-check" aria-hidden="true"></i> Bayar Sekarang';

    function resetTombol() {
        payBtn.disabled = false;
        payBtn.innerHTML = labelBayar;
    }

    payBtn.addEventListener('click', function () {
        if (typeof window.snap === 'undefined') {
            alert('Midtrans belum ter-load. Cek koneksi internet / matikan adblock, lalu refresh.');
            return;
        }
        if (!snapToken) {
            alert('Token pembayaran kosong. Coba refresh halaman.');
            return;
        }

        payBtn.disabled = true;
        payBtn.innerHTML = 'Memuat...';

        try {
            window.snap.pay(snapToken, {
                onSuccess: function (result) {
                    window.location.href = "{{ route('customer.checkout.selesai', $pesanan->id) }}";
                },
                onPending: function (result) {
                    window.location.href = "{{ route('customer.checkout.selesai', $pesanan->id) }}";
                },
                onError: function (result) {
                    console.error('Midtrans error:', result);
                    alert('Pembayaran gagal, silakan coba lagi.');
                    resetTombol();
                },
                onClose: function () {
                    resetTombol();
                }
            });
        } catch (e) {
            console.error('snap.pay error:', e);
            alert('Gagal membuka Midtrans: ' + e.message);
            resetTombol();
        }
    });
</script>
</body>

</html>
