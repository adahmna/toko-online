    }

    table.order-table td {
        padding: 12px 16px;
        font-size: 14px;
        border-bottom: 0.5px solid #e0e0e0;
    }

    .total-row td {
        background: #e8f5e9;
        font-weight: 500;
        color: #2e7d32;
    }

    .payment-section {
        padding: 20px;
        border-top: 0.5px solid #e0e0e0;
        text-align: center;
    }

    .payment-title {
        font-size: 14px;
        font-weight: 500;
        color: #212529;
        margin-bottom: 14px;
    }

    .notice {
        font-size: 12px;
        color: #6c757d;
        margin-top: 12px;
        display: flex;
        gap: 6px;
        align-items: center;
        justify-content: center;
    }

    .notice i {
        color: #F59E0B;
        font-size: 14px;
    }

    .footer-btns {
        display: flex;
        justify-content: space-between;
