    <style>
    .lamar-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
        align-items: center;
        padding: 30px 10px 50px;
    }

    .lamar-ilustrasi {
        flex: 1 1 380px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 300px;
    }

    .lamar-ilustrasi svg {
        width: 100%;
        max-width: 380px;
        animation: floatUpDown 3.5s ease-in-out infinite;
    }

    @keyframes floatUpDown {

        0%,
        100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-16px);
        }
    }

    .lamar-orbit {
        transform-origin: center;
        animation: spinSlow 12s linear infinite;
    }

    @keyframes spinSlow {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .lamar-form-box {
        flex: 1 1 420px;
        min-width: 300px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        padding: 32px 30px;
    }

    .lamar-form-box h2 {
        margin-bottom: 6px;
        font-weight: 700;
    }

    .lamar-subtitle {
        color: #777;
        margin-bottom: 24px;
        font-size: 14px;
    }

    .lamar-field {
        opacity: 0;
        transform: translateY(16px);
        animation: fadeUp 0.5s ease forwards;
    }

    .lamar-field:nth-child(1) {
        animation-delay: 0.05s;
    }

    .lamar-field:nth-child(2) {
        animation-delay: 0.15s;
    }

    .lamar-field:nth-child(3) {
        animation-delay: 0.25s;
    }

    .lamar-field:nth-child(4) {
        animation-delay: 0.35s;
    }

    .lamar-field:nth-child(5) {
        animation-delay: 0.45s;
    }

    .lamar-field:nth-child(6) {
        animation-delay: 0.55s;
    }

    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .lamar-form-box .form-group {
        margin-bottom: 18px;
    }

    .lamar-form-box label {
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 6px;
        display: block;
    }

    .lamar-form-box .input,
    .lamar-form-box textarea {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px 12px;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .lamar-form-box .input:focus,
    .lamar-form-box textarea:focus {
        border-color: #ff6600;
        box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.12);
        outline: none;
    }

    .lamar-btn-row {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .lamar-btn-row .primary-btn {
        border-radius: 8px;
        transition: transform 0.15s ease;
    }

    .lamar-btn-row .primary-btn:hover {
        transform: translateY(-2px);
    }

    @media (max-width: 767px) {
        .lamar-wrapper {
            padding: 15px 5px 30px;
            gap: 20px;
        }

        .lamar-ilustrasi,
        .lamar-form-box {
            min-width: 0;
            flex-basis: 100%;
        }

        .lamar-form-box {
            padding: 24px 18px;
        }
    }
    </style>

