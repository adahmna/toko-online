@php
    $ulasanList = \App\Models\ProductReview::with('user')
        ->where('produk_id', $produk->id)
        ->latest()
        ->get();
    $ulasanRata = $ulasanList->avg('rating');

    $logistikList = \App\Models\Pesanan::with('user')
        ->whereNotNull('rating_logistik')
        ->whereHas('details', fn ($q) => $q->where('produk_id', $produk->id))
        ->latest()
        ->get();
    $logistikRata = $logistikList->avg('rating_logistik');

    $samar = function ($nama) {
        $bagian = preg_split('/\s+/', trim((string) $nama), -1, PREG_SPLIT_NO_EMPTY);
        if (!$bagian) return 'Pelanggan';
        if (count($bagian) === 1) return mb_substr($bagian[0], 0, 2) . '***';
        $out = [$bagian[0]];
        foreach (array_slice($bagian, 1) as $b) { $out[] = mb_substr($b, 0, 1) . '***'; }
        return implode(' ', $out);
    };
@endphp

<div class="ulasan-produk" style="clear:both; width:100%; margin-top:40px; padding:20px 15px; border-top:1px solid #eee;">
    <h5 style="font-weight:700;">Ulasan Pembeli</h5>

    @if($ulasanList->count())
    <div style="margin-bottom:12px;">
        <span style="color:#f59f00; font-size:20px;">&#9733;</span>
        <strong>{{ number_format($ulasanRata, 1) }}</strong> / 5
        <span style="color:#888; font-size:13px;">({{ $ulasanList->count() }} ulasan)</span>
    </div>

    @foreach($ulasanList as $r)
    <div style="border-top:1px solid #eee; padding:12px 0;">
        <div>
            <strong>{{ $samar($r->user->nama ?? 'Pelanggan') }}</strong>
            <span style="color:#f59f00; margin-left:6px;">
                @for($i = 1; $i <= 5; $i++){!! $i <= $r->rating ? '&#9733;' : '&#9734;' !!}@endfor
            </span>
        </div>
        @if($r->komentar)
        <div style="font-size:14px; color:#444; margin-top:4px;">{{ $r->komentar }}</div>
        @endif
        @if($r->foto)
        <a href="{{ asset('storage/' . $r->foto) }}" target="_blank">
            <img src="{{ asset('storage/' . $r->foto) }}" alt="Foto ulasan"
                style="width:90px; height:90px; object-fit:cover; border-radius:8px; border:1px solid #eee; margin-top:6px;">
        </a>
        @endif
        <div style="font-size:12px; color:#999; margin-top:4px;">{{ $r->created_at->format('d M Y') }}</div>
    </div>
    @endforeach
    @else
    <p style="color:#888; font-size:13px;">Belum ada ulasan untuk produk ini.</p>
    @endif

    @if($logistikList->count())
    <h5 style="font-weight:700; margin-top:30px;">Penilaian Pengiriman</h5>
    <div style="margin-bottom:12px;">
        <span style="color:#f59f00; font-size:20px;">&#9733;</span>
        <strong>{{ number_format($logistikRata, 1) }}</strong> / 5
        <span style="color:#888; font-size:13px;">({{ $logistikList->count() }} penilaian)</span>
    </div>

    @foreach($logistikList as $l)
    <div style="border-top:1px solid #eee; padding:12px 0;">
        <div>
            <strong>{{ $samar($l->user->nama ?? 'Pelanggan') }}</strong>
            <span style="color:#f59f00; margin-left:6px;">
                @for($i = 1; $i <= 5; $i++){!! $i <= $l->rating_logistik ? '&#9733;' : '&#9734;' !!}@endfor
            </span>
            @if($l->ekspedisi)
            <span style="font-size:11px; color:#0d6efd; background:#e7f1ff; border-radius:4px; padding:1px 6px; margin-left:6px;">{{ strtoupper($l->ekspedisi) }}</span>
            @endif
        </div>
        @if(!empty($l->ulasan_logistik))
        <div style="font-size:14px; color:#444; margin-top:4px;">{{ $l->ulasan_logistik }}</div>
        @endif
        <div style="font-size:12px; color:#999; margin-top:4px;">{{ $l->updated_at->format('d M Y') }}</div>
    </div>
    @endforeach
    @endif
</div>