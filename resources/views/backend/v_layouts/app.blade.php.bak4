    <style>
    .notif-bell-wrapper {
        position: relative;
        display: inline-block;
    }

    .notif-badge {
        position: absolute;
        top: -4px;
        right: -6px;
        background: #ef5350;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .notif-badge.d-none {
        display: none !important;
    }

    .notif-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: 48px;
        width: 320px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        z-index: 9999;
        overflow: hidden;
    }

    .notif-dropdown.show {
        display: block;
    }

    .notif-header {
        background: #1e2a3a;
        color: #fff;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .notif-header span.mark-read {
        font-size: 11px;
        font-weight: 400;
        cursor: pointer;
        color: #90caf9;
        text-decoration: underline;
    }

    .notif-tabs {
        display: flex;
        border-bottom: 1px solid #e0e0e0;
    }

    .notif-tab {
        flex: 1;
        text-align: center;
        padding: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        color: #666;
        border-bottom: 2px solid transparent;
        transition: all 0.2s;
    }

    .notif-tab.active {
        color: #1976d2;
        border-bottom: 2px solid #1976d2;
    }

    .notif-tab.full-width {
        width: 100%;
    }

    .notif-body {
        max-height: 280px;
        overflow-y: auto;
    }

    .notif-item {
        padding: 10px 14px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 12px;
        line-height: 1.5;
    }

    .notif-item:last-child {
        border-bottom: none;
    }

    .notif-item .notif-title {
        font-weight: 600;
        color: #1a237e;
        margin-bottom: 2px;
    }

    .notif-item .notif-sub {
        color: #555;
    }

    .notif-item .notif-time {
        color: #aaa;
        font-size: 11px;
        margin-top: 2px;
    }

    .notif-empty {
        text-align: center;
        padding: 20px;
        color: #aaa;
        font-size: 12px;
    }

    .notif-footer {
        text-align: center;
        padding: 10px;
        border-top: 1px solid #f0f0f0;
    }

    .notif-footer a {
        font-size: 12px;
        color: #1976d2;
        text-decoration: none;
    }

    .tab-content-notif {
        display: none;
    }

    .tab-content-notif.active {
        display: block;
    }

    /* ===== BANNER KONTAK ===== */
