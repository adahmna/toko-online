    <style>
    .notif-bell-wrapper {
        position: relative;
        display: inline-block;
    }

    .notif-badge {
        position: absolute;
        top: -4px;
        right: -6px;
        background: #ef5350;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .notif-badge.d-none {
        display: none !important;
    }

    .notif-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: 48px;
        width: 320px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        z-index: 9999;
        overflow: hidden;
    }

    .notif-dropdown.show {
        display: block;
    }

    .notif-header {
        background: #1e2a3a;
        color: #fff;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .notif-header span.mark-read {
        font-size: 11px;
        font-weight: 400;
        cursor: pointer;
        color: #90caf9;
        text-decoration: underline;
    }

    .notif-tabs {
        display: flex;
        border-bottom: 1px solid #e0e0e0;
    }

    .notif-tab {
        flex: 1;
        text-align: center;
        padding: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        color: #666;
        border-bottom: 2px solid transparent;
        transition: all 0.2s;
    }

    .notif-tab.active {
        color: #1976d2;
        border-bottom: 2px solid #1976d2;
    }

    .notif-tab.full-width {
        width: 100%;
    }

    .notif-body {
        max-height: 280px;
        overflow-y: auto;
    }

    .notif-item {
        padding: 10px 14px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 12px;
        line-height: 1.5;
    }

    .notif-item:last-child {
        border-bottom: none;
    }

    .notif-item .notif-title {
        font-weight: 600;
        color: #1a237e;
        margin-bottom: 2px;
    }

    .notif-item .notif-sub {
        color: #555;
    }

    .notif-item .notif-time {
        color: #aaa;
        font-size: 11px;
        margin-top: 2px;
    }

    .notif-empty {
        text-align: center;
        padding: 20px;
        color: #aaa;
        font-size: 12px;
    }

    .notif-footer {
        text-align: center;
        padding: 10px;
        border-top: 1px solid #f0f0f0;
    }

    .notif-footer a {
        font-size: 12px;
        color: #1976d2;
        text-decoration: none;
    }

    .tab-content-notif {
        display: none;
    }

    .tab-content-notif.active {
        display: block;
    }

    /* ===== BANNER KONTAK ===== */
    .banner-kontak {
        border-left: 5px solid #25d366;
        background: #f0fff4;
        border-radius: 6px;
        padding: 10px 16px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .banner-kontak .banner-icon {
        font-size: 26px;
    }

    .banner-kontak .banner-text h6 {
        margin: 0 0 2px;
        font-weight: 700;
        font-size: 13px;
        color: #1a3c2a;
    }

    .banner-kontak .banner-text p {
        margin: 0;
        font-size: 12px;
        color: #555;
    }

    .banner-kontak .banner-actions {
        margin-left: auto;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .banner-kontak .btn-wa {
        background: #25d366;
        color: #fff;
        border: none;
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 12px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .banner-kontak .btn-wa:hover {
        background: #1ebe5d;
        color: #fff;
    }

    .banner-kontak .btn-email {
        background: #fff;
        color: #555;
        border: 1px solid #ccc;
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 12px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .banner-kontak .btn-email:hover {
        background: #f5f5f5;
        color: #333;
    }

    /* ===== END BANNER KONTAK ===== */

    /* ===== HAMBURGER ANIMATION ===== */
    .hamburger-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: background 0.2s;
    }

    .hamburger-btn:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .hamburger-box {
        width: 24px;
        height: 18px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .hamburger-line {
        display: block;
        width: 100%;
        height: 2px;
        background: #fff;
        border-radius: 2px;
        transition: all 0.35s cubic-bezier(0.645, 0.045, 0.355, 1.000);
        transform-origin: center;
    }

    /* Animasi saat aktif (sidebar mini) */
    .hamburger-btn.is-active .hamburger-line:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }

    .hamburger-btn.is-active .hamburger-line:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }

    .hamburger-btn.is-active .hamburger-line:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    /* ===== END HAMBURGER ANIMATION ===== */
