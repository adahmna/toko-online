    </script>

    <script>
    $(document).ready(function() {

        // ===== HAMBURGER ANIMATION =====
        $('#hamburgerToggle').on('click', function() {
            $('#hamburgerBtn').toggleClass('is-active');
        });
        // ===== END HAMBURGER ANIMATION =====

        // ===== NOTIFIKASI MUNCUL SAAT HOVER =====
        let notifHoverTimeout;
        $('#notifBellWrapper').on('mouseenter', function() {
            clearTimeout(notifHoverTimeout);
            $('#notifDropdown').addClass('show');
        }).on('mouseleave', function() {
            notifHoverTimeout = setTimeout(function() {
                $('#notifDropdown').removeClass('show');
            }, 200);
        });

        // Tetap bisa dibuka via klik (misalnya di layar sentuh)
        $('#notifBellBtn').on('click', function(e) {
            e.stopPropagation();
            $('#notifDropdown').toggleClass('show');

            // kalau masih ada angka di badge -> tandai sudah dibaca
            if (!$('#notifCount').hasClass('d-none')) {
                // angka langsung hilang (isi list tetap ditampilkan biar bisa dibaca)
                $('#notifCount').addClass('d-none').text('0');
                $('#notifHeaderText').text('Notifikasi (0)');

                // simpan ke server supaya nggak muncul lagi pas polling / refresh
                $.ajax({
                    url: '{{ route("backend.notifikasi.dibaca") }}',
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                    }
                });
            }
        });

        $(document).on('click', function(e) {
            if (!$('#notifBellWrapper').is(e.target) && $('#notifBellWrapper').has(e.target).length ===
                0) {
                $('#notifDropdown').removeClass('show');
            }
        });
        // ===== END NOTIFIKASI HOVER =====

        // ===== DROPDOWN PROFIL MUNCUL SAAT HOVER =====
        let profileHoverTimeout;
        $('.nav-item.dropdown').on('mouseenter', function() {
            clearTimeout(profileHoverTimeout);
            $(this).addClass('show');
            $(this).find('.dropdown-menu').addClass('show');
        }).on('mouseleave', function() {
            const $this = $(this);
            profileHoverTimeout = setTimeout(function() {
                $this.removeClass('show');
                $this.find('.dropdown-menu').removeClass('show');
            }, 200);
        });
        // ===== END DROPDOWN PROFIL HOVER =====

        $('.notif-tab').on('click', function() {
            const tab = $(this).data('tab');
            $('.notif-tab').removeClass('active');
            $(this).addClass('active');
            $('.tab-content-notif').removeClass('active');
            $('#tab-' + tab).addClass('active');
        });

        $('#markAllRead').on('click', function() {
            $.ajax({
                url: '{{ route("backend.notifikasi.dibaca") }}',
                method: 'POST',
                headers: {
                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                },
                success: function() {
                    $('#notifCount').addClass('d-none').text('0');
                    $('#notifHeaderText').text('Notifikasi (0)');
                    $('#tab-pesanan').html(
                        '<div class="notif-empty">Tidak ada notifikasi baru</div>');
                    if ($('#tab-user').length) {
                        $('#tab-user').html(
                            '<div class="notif-empty">Tidak ada notifikasi baru</div>');
                    }
                }
            });
        });

        function fetchNotifikasi() {
            $.ajax({
                url: '{{ route("backend.notifikasi") }}',
                method: 'GET',
                success: function(data) {
                    const total = data.total_unread;
                    if (total > 0) {
                        $('#notifCount').removeClass('d-none').text(total > 99 ? '99+' : total);
                    } else {
                        $('#notifCount').addClass('d-none').text('0');
                    }
                    $('#notifHeaderText').text('Notifikasi (' + total + ')');

                    let htmlPesanan = '';
                    if (data.orders.length > 0) {
                        data.orders.forEach(function(o) {
                            let nomorPesanan = o.kode_pesanan || 'Baru';
                            let detailCustomer = (o.customer_name === 'Pesanan Anda') ? '' :
                                `<div class="notif-sub">Customer: ${o.customer_name}</div>`;
                            htmlPesanan += `
                                    <div class="notif-item">
                                        <div class="notif-title">🛒 ${o.customer_name === 'Pesanan Anda' ? 'Pesanan Anda' : 'Pesanan'} #${nomorPesanan}</div>
                                        ${detailCustomer}
                                        <div class="notif-sub">Total: ${o.total_format} &nbsp;|&nbsp;
                                            <span class="badge badge-warning">${o.status}</span>
                                        </div>
                                        <div class="notif-time">${o.waktu}</div>
                                    </div>`;
                        });
                    } else {
                        htmlPesanan =
                            '<div class="notif-empty">Tidak ada riwayat transaksi baru</div>';
                    }
                    $('#tab-pesanan').html(htmlPesanan);

                    if ($('#tab-user').length) {
                        let htmlUser = '';
                        if (data.users.length > 0) {
                            data.users.forEach(function(u) {
                                htmlUser += `
                                        <div class="notif-item">
                                            <div class="notif-title">👤 ${u.nama}</div>
                                            <div class="notif-sub">Email: ${u.email}</div>
                                            <div class="notif-sub">Role: <span class="badge badge-info">${u.role}</span></div>
                                            <div class="notif-time">${u.waktu}</div>
                                        </div>`;
                            });
                        } else {
                            htmlUser = '<div class="notif-empty">Tidak ada user baru</div>';
                        }
                        $('#tab-user').html(htmlUser);
                    }
                }
            });
        }

        fetchNotifikasi();
        setInterval(fetchNotifikasi, 15000);
    });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    @if (!$isCustomer)
    {{-- ===== BADGE LIVE CHAT ADMIN (pesan belum dibaca) ===== --}}
    <script>
    (function() {
        const badge = document.getElementById('sidebarChatBadge');
        if (!badge) return;

        async function checkChatUnread() {
            try {
                const res = await fetch("{{ route('backend.livechat.conversations') }}", {
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                if (res.ok) {
                    const data = await res.json();
                    badge.style.display = data.total_unread > 0 ? 'inline-block' : 'none';
                    badge.textContent = data.total_unread > 9 ? '9+' : data.total_unread;
                }
            } catch (e) {}
        }

        checkChatUnread();
        setInterval(checkChatUnread, 10000);
    })();
    </script>
    {{-- ===== END BADGE LIVE CHAT ===== --}}
    @endif

    @stack('scripts')

