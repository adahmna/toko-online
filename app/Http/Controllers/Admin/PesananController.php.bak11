<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\Pesanan;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Mail;
use App\Mail\StatusPesananMail;
use Illuminate\Support\Facades\Log;

class PesananController extends Controller
{
    public function index()
    {
        $pesanan = Pesanan::with('user')->latest()->get();
        return view('backend.pesanan.index', compact('pesanan'));
    }

    /**
     * Halaman "Detail Pesanan" — mirip tampilan di modul.
     */
    public function detail($id)
    {
        $item = Pesanan::with(['user', 'details.produk'])->findOrFail($id);
        return view('backend.pesanan.detail', compact('item'));
    }

    /**
     * Halaman cetak pesanan (tampilan polos untuk di-print).
     */
    public function cetak($id)
    {
        $item = Pesanan::with(['user', 'details.produk'])->findOrFail($id);
        return view('backend.pesanan.cetak', compact('item'));
    }

    public function update(Request $request, $id)
    {
        $request->validate([
            'status_pesanan'    => 'required',
            'ekspedisi'         => 'nullable|string|max:100',
            'layanan_ekspedisi' => 'nullable|string|max:100',
            'no_resi'           => 'nullable|string|max:100',
            'alamat'            => 'nullable|string',
            'kode_pos'          => 'nullable|string|max:20',
        ]);

        $pesanan         = Pesanan::findOrFail($id);
        $pesanan->status = $request->status_pesanan;

        // Simpan data ekspedisi hanya jika status = dikirim
        if (strtolower($request->status_pesanan) === 'dikirim') {
            if ($request->filled('ekspedisi')) {
                $pesanan->ekspedisi = $request->ekspedisi;
            }
            if ($request->filled('layanan_ekspedisi')) {
                $pesanan->layanan_ekspedisi = $request->layanan_ekspedisi;
            }
            $pesanan->no_resi = $request->no_resi;
        }

        // Alamat & kode pos bisa dikoreksi dari halaman detail
        if ($request->filled('alamat')) {
            $pesanan->alamat = $request->alamat;
        }
        if ($request->filled('kode_pos')) {
            $pesanan->kode_pos = $request->kode_pos;
        }

        $pesanan->save();

        // Kirim email notifikasi setelah response dikirim ke browser (non-blocking)
        if ($pesanan->user && $pesanan->user->email) {
            $email = $pesanan->user->email;
            $mail  = new StatusPesananMail($pesanan);

            try {
                Mail::to($email)->send($mail);
            } catch (\Exception $e) {
                Log::error('[Pesanan] Gagal kirim email: ' . $e->getMessage());
            }
        }

        // Dipanggil lewat AJAX (modal index lama) → balikin JSON
        if ($request->wantsJson() || $request->ajax()) {
            return response()->json([
                'success' => true,
                'message' => 'Status pesanan berhasil diperbarui dan email notifikasi telah dikirim!',
            ]);
        }

        // Dipanggil lewat form biasa (halaman detail) → redirect kembali
        return redirect()
            ->route('admin.pesanan.detail', $pesanan->id)
            ->with('success', 'Status pesanan berhasil diperbarui dan email notifikasi telah dikirim!');
    }

    public function tracking($id)
    {
        $pesanan = Pesanan::where('id', $id)
            ->where('user_id', auth()->id())
            ->firstOrFail();

        $dasar = [
            'ekspedisi' => $pesanan->ekspedisi,
            'layanan'   => $pesanan->layanan_ekspedisi,
            'no_resi'   => $pesanan->no_resi,
        ];

        $kurir = $this->kodeKurirBinderbyte($pesanan->ekspedisi);
        $resi  = trim((string) $pesanan->no_resi);

        if ($kurir === '' || $resi === '') {
            return response()->json($dasar + [
                'tersedia' => false,
                'pesan'    => 'Nomor resi atau ekspedisi belum lengkap.',
            ]);
        }

        // Hasil sukses di-cache supaya credit API tidak terpakai tiap modal dibuka
        $cacheKey = 'tracking_' . $pesanan->id . '_' . md5($kurir . '|' . $resi);
        $cached   = \Illuminate\Support\Facades\Cache::get($cacheKey);
        if (is_array($cached)) {
            return response()->json($dasar + $cached);
        }

        try {
            $resp = \Illuminate\Support\Facades\Http::timeout(10)->get('https://api.binderbyte.com/v1/track', [
                'api_key' => config('services.binderbyte.api_key'),
                'courier' => $kurir,
                'awb'     => $resi,
            ]);
        } catch (\Throwable $e) {
            \Illuminate\Support\Facades\Log::warning('[Tracking] Binderbyte tidak terjangkau: ' . $e->getMessage());
            return response()->json($dasar + [
                'tersedia' => false,
                'pesan'    => 'Layanan pelacakan sedang tidak bisa dihubungi. Coba lagi nanti atau cek di website ekspedisi.',
            ]);
        }

        $json = $resp->json();

        if (!$resp->ok() || (int) ($json['status'] ?? 0) !== 200) {
            $apiMsg = (string) ($json['message'] ?? '');
            \Illuminate\Support\Facades\Log::error('[Tracking] Binderbyte gagal ' . $kurir . '/' . $resi . ': HTTP ' . $resp->status() . ' ' . $apiMsg);

            $tidakKetemu = (bool) preg_match('/not found|tidak ditemukan|invalid/i', $apiMsg);
            return response()->json($dasar + [
                'tersedia' => false,
                'pesan'    => $tidakKetemu
                    ? 'Resi belum ditemukan di sistem ekspedisi. Pastikan nomor resi dan ekspedisinya sesuai, atau coba lagi nanti.'
                    : 'Data pelacakan sedang tidak tersedia. Silakan cek langsung di website ekspedisi.',
            ]);
        }

        $data = $json['data'] ?? [];

        $history = collect($data['history'] ?? [])->map(function ($h) {
            $raw   = (string) ($h['date'] ?? '');
            $waktu = $raw;
            try {
                if ($raw !== '') {
                    $waktu = \Illuminate\Support\Carbon::parse($raw)->format('d M Y, H:i') . ' WIB';
                }
            } catch (\Throwable $e) {
            }
            return [
                'status' => (string) ($h['desc'] ?? '-'),
                'lokasi' => trim((string) ($h['location'] ?? '')),
                'waktu'  => $waktu,
                'tipe'   => 'done',
                'ts'     => strtotime($raw) ?: 0,
            ];
        })->sortByDesc('ts')->values()->map(function ($h) {
            unset($h['ts']);
            return $h;
        })->all();

        if (empty($history)) {
            return response()->json($dasar + [
                'tersedia' => false,
                'pesan'    => 'Belum ada riwayat perjalanan dari ekspedisi. Paket mungkin baru diserahkan, coba lagi nanti.',
            ]);
        }

        $history[0]['tipe'] = 'current';

        $statusKurir = strtoupper((string) ($data['summary']['status'] ?? ''));
        $asal   = trim((string) ($data['detail']['origin'] ?? ''));
        $tujuan = trim((string) ($data['detail']['destination'] ?? ''));

        $alamat = '';
        if ($asal !== '' || $tujuan !== '') {
            $alamat = trim('Asal: ' . ($asal ?: '-') . ' → Tujuan: ' . ($tujuan ?: '-'));
        }

        $hasil = [
            'tersedia'        => true,
            'status_kurir'    => $statusKurir,
            'estimasi_tiba'   => $statusKurir === 'DELIVERED'
                ? 'Paket sudah diterima'
                : 'Hubungi ekspedisi untuk estimasi tiba',
            'posisi_sekarang' => [
                'nama'   => $history[0]['lokasi'] !== '' ? $history[0]['lokasi'] : $history[0]['status'],
                'alamat' => $alamat !== '' ? $alamat : $history[0]['status'],
            ],
            'riwayat'         => $history,
        ];

        \Illuminate\Support\Facades\Cache::put(
            $cacheKey,
            $hasil,
            now()->addMinutes($statusKurir === 'DELIVERED' ? 360 : 30)
        );

        return response()->json($dasar + $hasil);
    }

    // Samakan nama ekspedisi di DB dengan kode kurir Binderbyte
    private function kodeKurirBinderbyte(?string $e): string
    {
        $e = preg_replace('/[^a-z0-9]/', '', strtolower(trim((string) $e)));
        $map = [
            'jne' => 'jne', 'jnexpress' => 'jne',
            'jnt' => 'jnt', 'jt' => 'jnt', 'jet' => 'jnt', 'jtexpress' => 'jnt',
            'sicepat' => 'sicepat',
            'anteraja' => 'anteraja',
            'pos' => 'pos', 'posindonesia' => 'pos',
            'tiki' => 'tiki',
            'ninja' => 'ninja', 'ninjaxpress' => 'ninja',
            'sap' => 'sap',
        ];
        return $map[$e] ?? $e;
    }
}